# HTTP port for the server.
PORT=3000

# Transcriber backend: "mock" (no key, deterministic) or "gemini" (real transcription).
# Defaults to "gemini" when GEMINI_API_KEY is set, otherwise "mock".
TRANSCRIBER=mock

# Required when TRANSCRIBER=gemini.
GEMINI_API_KEY=

# Gemini model used for transcription + translation.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of predefined session ids/names shown even before any
# audio is ingested. Sessions are also auto-created on first ingest.
SESSIONS=main-stage,room-a,room-b
