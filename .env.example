# HTTP port for the server.
PORT=3000

# Transcriber backend: "mock" (no key, deterministic) or "gemini" (real transcription).
# Leave empty to auto-detect: "gemini" when GEMINI_API_KEY is set, otherwise "mock".
TRANSCRIBER=

# Required when TRANSCRIBER=gemini.
GEMINI_API_KEY=

# Gemini model used for transcription + translation.
GEMINI_MODEL=gemini-3.5-flash-lite

# Thinking effort for Gemini 3.x models (minimal|low|medium|high). Ignored on
# 2.x models, which always run with thinking disabled. Defaults to the
# model's lowest available level ("minimal" on 3.5 Flash-Lite / 3.6 Flash,
# "low" on 3.7 / 3.8 Flash) when unset or invalid.
GEMINI_THINKING_LEVEL=

# Comma-separated list of predefined session ids/names shown even before any
# audio is ingested. Sessions are also auto-created on first ingest.
SESSIONS=main-stage,room-a,room-b
